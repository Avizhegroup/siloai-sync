@page "/knowledge"
@attribute [Authorize]
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>پایگاه دانش — پنل مدیریت هوش مصنوعی سیلو</PageTitle>

<div class="card-ai mb-4">
    <div class="card-ai-header">
        <span><i class="bi bi-cloud-upload me-2"></i>بارگذاری فایل دانش</span>
    </div>
    <div class="p-4">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label fw-semibold">نوع سند</label>
                <select class="form-select" @bind="_docType">
                    @foreach (var type in Enum.GetValues<RagDocType>())
                    {
                        <option value="@type">@type.ToDisplay()</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold">کلید (اختیاری)</label>
                <input type="text" class="form-control" placeholder="مثلاً: hr-policy-2025" @bind="_key" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold">دسته‌بندی</label>
                <input type="text" class="form-control" placeholder="مثلاً: قوانین احراز هویت" @bind="_category" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold">برچسب‌ها (اختیاری)</label>
                <input type="text" class="form-control" placeholder="مثلاً: auth,security" @bind="_tags" />
            </div>
            <div class="col-md-12">
                <label class="form-label fw-semibold">فایل</label>
                <InputFile OnChange="OnFileSelected" class="form-control" accept=".txt,.md,.markdown" />
            </div>
        </div>
        <div class="mt-3 d-flex gap-2 align-items-center">
            <button class="btn btn-primary" @onclick="UploadAsync" disabled="@(_isUploading || _selectedFile is null)">
                @if (_isUploading)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                }
                else
                {
                    <i class="bi bi-cloud-arrow-up me-1"></i>
                }
                بارگذاری و پردازش
            </button>
            @if (_selectedFile is not null)
            {
                <span class="text-muted small">
                    <i class="bi bi-file-earmark me-1"></i>@_selectedFile.Name (@FormatBytes(_selectedFile.Size))
                </span>
            }
        </div>
    </div>
</div>

<div class="card-ai">
    <div class="card-ai-header">
        <span><i class="bi bi-collection me-2"></i>فایل‌های دانش</span>
        <span class="text-muted small">@(_documents?.Count ?? 0) فایل</span>
    </div>
    @if (_isLoading && _documents is null)
    {
        <div class="p-4 text-center text-muted">
            <div class="spinner-border spinner-border-sm me-2"></div>در حال بارگذاری...
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>نام فایل</th>
                        <th>نوع</th>
                        <th>کلید</th>
                        <th>دسته‌بندی</th>
                        <th>اندازه</th>
                        <th>تعداد قطعات</th>
                        <th>وضعیت</th>
                        <th>تاریخ ثبت</th>
                        <th class="text-end">عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_documents is { Count: 0 })
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-4">
                                <i class="bi bi-collection me-2"></i>هیچ فایلی بارگذاری نشده است.
                            </td>
                        </tr>
                    }
                    @foreach (var doc in _documents ?? [])
                    {
                        <tr>
                            <td class="fw-semibold">@doc.OriginalFileName</td>
                            <td><span class="badge bg-secondary">@doc.DocType.ToDisplay()</span></td>
                            <td class="text-muted">@(doc.Key ?? "—")</td>
                            <td>@(doc.Category ?? "—")</td>
                            <td class="text-muted">@FormatBytes(doc.FileSize)</td>
                            <td>@doc.ChunkCount</td>
                            <td>
                                @switch (doc.ProcessingStatus)
                                {
                                    case "Completed":
                                        <span class="badge bg-success">تکمیل شد</span>
                                        break;
                                    case "Processing":
                                        <span class="badge bg-info">در حال پردازش</span>
                                        break;
                                    case "Failed":
                                        <span class="badge bg-danger" title="@doc.ProcessingError">خطا</span>
                                        break;
                                    default:
                                        <span class="badge bg-secondary">@doc.ProcessingStatus</span>
                                        break;
                                }
                            </td>
                            <td class="text-muted">@doc.CreateDateTime.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-secondary me-1"
                                        @onclick="() => StartRebuild(doc)" disabled="@_isUploading">
                                    <i class="bi bi-arrow-clockwise me-1"></i>بازسازی
                                </button>
                                <button class="btn btn-sm btn-outline-danger"
                                        @onclick="() => DeleteAsync(doc.Id)" disabled="@_isUploading">
                                    <i class="bi bi-trash me-1"></i>حذف
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (_rebuildTarget is not null)
{
    <div class="card-ai mt-4">
        <div class="card-ai-header">
            <span><i class="bi bi-arrow-clockwise me-2"></i>بازسازی embeddings برای: @_rebuildTarget.OriginalFileName</span>
            <button class="btn btn-sm btn-outline-secondary" @onclick="() => _rebuildTarget = null">
                <i class="bi bi-x me-1"></i>بستن
            </button>
        </div>
        <div class="p-4">
            <InputFile OnChange="OnRebuildFileSelected" class="form-control" accept=".txt,.md,.markdown" />
            <div class="mt-3 d-flex gap-2 align-items-center">
                <button class="btn btn-primary"
                        @onclick="RebuildAsync"
                        disabled="@(_isUploading || _rebuildFile is null)">
                    @if (_isUploading)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    else
                    {
                        <i class="bi bi-arrow-clockwise me-1"></i>
                    }
                    اجرای بازسازی
                </button>
                @if (_rebuildFile is not null)
                {
                    <span class="text-muted small">
                        <i class="bi bi-file-earmark me-1"></i>@_rebuildFile.Name (@FormatBytes(_rebuildFile.Size))
                    </span>
                }
            </div>
        </div>
    </div>
}
