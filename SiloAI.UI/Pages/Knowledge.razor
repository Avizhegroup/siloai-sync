@page "/knowledge"
@attribute [Authorize]
@using Microsoft.AspNetCore.Components.Forms
@using Telerik.Blazor.Components
@using Microsoft.AspNetCore.Components.Web
@using SiloAI.UI.Components
@using SiloAI.Shared.Tools

<PageTitle>پایگاه دانش — پنل مدیریت هوش مصنوعی سیلو</PageTitle>

<div class="card-ai mb-4">
    <div class="card-ai-header">
        <span>
            <i class="bi bi-cloud-upload me-2"></i>
            بارگذاری فایل دانش
        </span>
    </div>
    <div class="p-4">
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label">نوع سند</label>
                <TelerikDropDownList Data="@DocTypes"
                                     TItem="RagDocTypeItem"
                                     TValue="RagDocType"
                                     TextField="Title"
                                     ValueField="Code"
                                     @bind-Value="_docType"
                                     Width="100%" />
            </div>
            <div class="col-md-3">
                <label class="form-label">
                    کلید <span class="text-muted fw-normal">(اختیاری)</span>
                </label>
                <TelerikTextBox @bind-Value="_key"
                                Placeholder="مثلاً: hr-policy-2025"
                                Width="100%" />
            </div>
            <div class="col-md-3">
                <label class="form-label">دسته‌بندی</label>
                <TelerikTextBox @bind-Value="_category"
                                Placeholder="مثلاً: قوانین احراز هویت"
                                Width="100%" />
            </div>
            <div class="col-md-3">
                <label class="form-label">
                    برچسب‌ها <span class="text-muted fw-normal">(اختیاری)</span>
                </label>
                <TelerikTextBox @bind-Value="_tags"
                                Placeholder="مثلاً: auth,security"
                                Width="100%" />
            </div>
            <div class="col-12">
                <label class="form-label">فایل</label>
                <div class="file-drop @(_selectedFile is null ? "" : "has-file")">

                    @if (_selectedFile is null)
                    {
                        <div class="py-3 text-center">
                            <i class="bi bi-cloud-arrow-up text-primary fs-1 mb-2 d-block"></i>
                            <p class="mb-2 fw-medium">فایل متنی را انتخاب کنید</p>
                            <label class="btn btn-outline-primary btn-sm px-4">
                                <i class="bi bi-folder2-open me-1"></i>
                                انتخاب فایل
                                <InputFile OnChange="OnFileSelected"
                                           class="d-none"
                                           accept=".txt,.md,.markdown" />
                            </label>
                        </div>
                    }
                    else
                    {
                        <div class="file-chip">
                            <div class="file-chip-icon">
                                <i class="bi bi-file-earmark-text"></i>
                            </div>
                            <div class="file-chip-info">
                                <div class="file-chip-name" title="@_selectedFile.Name">
                                    @_selectedFile.Name
                                </div>
                                <div class="file-chip-meta">
                                    <span class="file-chip-ext">
                                        @(System.IO.Path.GetExtension(_selectedFile.Name).TrimStart('.').ToUpperInvariant())
                                    </span>
                                    <span class="mono" dir="ltr">@FormatBytes(_selectedFile.Size)</span>
                                </div>
                            </div>
                            <button type="button"
                                    class="file-chip-remove"
                                    @onclick="() => _selectedFile = null"
                                    title="حذف فایل">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="mt-4 d-flex flex-wrap gap-2 align-items-center justify-content-between">
            <div class="d-flex gap-2">
                <button type="button"
                        class="btn btn-primary px-4"
                        @onclick="UploadAsync"
                        disabled="@(_isUploading || _selectedFile is null)">
                    <i class="bi bi-cloud-arrow-up me-2"></i>
                    <span>بارگذاری و پردازش</span>
                </button>
                <button type="button"
                        class="btn btn-outline-secondary"
                        @onclick="OnOpenKnowledgeFilesModal">
                    <i class="bi bi-collection me-1"></i>
                    فایل‌های دانش
                </button>
            </div>

            @if (_selectedFile is not null && !_isUploading)
            {
                <span class="text-success small">
                    <i class="bi bi-check-circle-fill me-1"></i>
                    فایل آماده بارگذاری است
                </span>
            }
        </div>
    </div>
</div>

<Modal Buttons="ModalButtons.Close"
       ModalTitle="فایل‌های دانش"
       CloseBtnText="بستن"
       @ref="ModalKnowledgeFiles"
       Size="ModalSize.ExtraLarge">
    <ModalBodyContentHtml>
        @if (_documents is { Count: 0 })
        {
            <div class="p-5 text-center text-muted">
                <i class="bi bi-collection fs-2 d-block mb-2"></i>
                هیچ فایلی بارگذاری نشده است.
            </div>
        }
        else if (_documents is not null)
        {
            <TelerikGrid Data="@_documents"
                         PageSize="10"
                         Navigable="true"
                         Pageable="true"
                         Sortable="true"
                         Resizable="true">
                <RowTemplate Context="doc">
                    <td> <span class="fw-medium">@doc.OriginalFileName</span> </td>
                    <td> <span class="badge-neutral">@doc.DocType.ToDisplay()</span> </td>
                    <td> <span class="mono text-muted" dir="ltr">@(doc.Key ?? "—")</span> </td>
                    <td> @(doc.Category ?? "—") </td>
                    <td> <span class="mono text-muted" dir="ltr">@FormatBytes(doc.FileSize)</span> </td>
                    <td> <span class="mono">@doc.ChunkCount</span> </td>
                    <td>
                        @switch (doc.ProcessingStatus)
                        {
                            case "Completed":
                                <span class="badge-active">تکمیل شد</span>
                                break;
                            case "Processing":
                                <span class="badge-neutral">در حال پردازش</span>
                                break;
                            case "Failed":
                                <span class="badge-revoked" title="@doc.ProcessingError">خطا</span>
                                break;
                            default:
                                <span class="badge-neutral">@doc.ProcessingStatus</span>
                                break;
                        }
                    </td>
                    <td>
                        <span class="mono text-muted"> @DateTimeTools.GetUnixPersianTime(doc.CreateDateTime).ToNormalPersianDateTime() </span>
                    </td>
                    <td class="text-end">
                        @if (_rebuildTarget?.Id == doc.Id)
                        {
                            <InputFile OnChange="OnRebuildFileSelected"
                                       class="form-control"
                                       accept=".txt,.md,.markdown"
                                       disabled="@_isUploading" />
                        }
                        else
                        {
                            <button type="button"
                                    class="btn btn-sm btn-outline-secondary me-1"
                                    @onclick="() => StartRebuild(doc)"
                                    disabled="@_isUploading">
                                <i class="bi bi-arrow-clockwise me-1"></i>
                                بازسازی
                            </button>
                            <button type="button"
                                    class="btn btn-sm btn-outline-danger"
                                    @onclick="() => DeleteAsync(doc.Id)"
                                    disabled="@_isUploading">
                                <i class="bi bi-trash me-1"></i>
                                حذف
                            </button>
                        }
                    </td>
                </RowTemplate>
                <GridColumns>
                    <GridColumn Field="@nameof(RagDocumentDto.OriginalFileName)" Title="نام فایل" Width="270px" />
                    <GridColumn Field="@nameof(RagDocumentDto.DocType)" Title="نوع" Width="130px" />
                    <GridColumn Field="@nameof(RagDocumentDto.Key)" Title="کلید" Width="160px" />
                    <GridColumn Field="@nameof(RagDocumentDto.Category)" Title="دسته‌بندی" Width="180px" />
                    <GridColumn Field="@nameof(RagDocumentDto.FileSize)" Title="اندازه" Width="75px" />
                    <GridColumn Field="@nameof(RagDocumentDto.ChunkCount)" Title="قطعات" Width="65px" />
                    <GridColumn Field="@nameof(RagDocumentDto.ProcessingStatus)" Title="وضعیت" Width="120px" />
                    <GridColumn Field="@nameof(RagDocumentDto.CreateDateTime)" Title="تاریخ ثبت" Width="180px" />
                    <GridColumn Title="عملیات" Width="250px" />
                </GridColumns>
            </TelerikGrid>
        }
    </ModalBodyContentHtml>
</Modal>

<TelerikDialog @bind-Visible="_showRebuildResult"
               Title="بازسازی فایل"
               Width="300px">
    <DialogContent>
        <div class="text-center">
            <i class="bi bi-check-circle-fill text-success fs-1"></i>
            <h6 class="fw-bold mt-2 mb-2">بازسازی فایل با موفقیت انجام شد</h6>
            @if (_rebuildChunkCount.HasValue)
            {
                <span class="badge-neutral">
                    تعداد قطعات: <span class="mono">@_rebuildChunkCount</span>
                </span>
            }
        </div>
    </DialogContent>
    <DialogButtons>
        <TelerikButton ThemeColor="primary" OnClick="@(() => _showRebuildResult = false)">
            متوجه شدم
        </TelerikButton>
    </DialogButtons>
</TelerikDialog>

@if (_isUploading || _isLoading)
{
    <TelerikLoaderContainer LoaderPosition="@LoaderPosition.End"
                            LoaderType="LoaderType.InfiniteSpinner"
                            Text="@(_isUploading ? "در حال پردازش..." : TextResources.APP_StringKeys_Loading)">
    </TelerikLoaderContainer>
}
