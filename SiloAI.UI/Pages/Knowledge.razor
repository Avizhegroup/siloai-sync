@page "/knowledge"
@attribute [Authorize]
@using Microsoft.AspNetCore.Components.Forms
@using Telerik.Blazor.Components
@using Microsoft.AspNetCore.Components.Web
@using SiloAI.UI.Components
@using SiloAI.Shared.Tools

<PageTitle>پایگاه دانش — پنل مدیریت هوش مصنوعی سیلو</PageTitle>

<div class="card-ai mb-4">
    <div class="card-ai-header">
        <span>
            <i class="bi bi-cloud-upload me-2"></i>
            بارگذاری فایل دانش
        </span>
    </div>

    <div class="p-4">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label fw-semibold">نوع سند</label>
                <TelerikDropDownList Data="@DocTypes"
                                     TItem="DocTypeItem"
                                     TValue="RagDocType"
                                     TextField="Title"
                                     ValueField="Code"
                                     @bind-Value="_docType"
                                     Class="w-100" />
            </div>

            <div class="col-md-3">
                <label class="form-label fw-semibold">
                    کلید (اختیاری)
                </label>
                <TelerikTextBox @bind-Value="_key"
                                Placeholder="مثلاً: hr-policy-2025"
                                Class="w-100" />
            </div>

            <div class="col-md-3">
                <label class="form-label fw-semibold">
                    دسته‌بندی
                </label>
                <TelerikTextBox @bind-Value="_category"
                                Placeholder="مثلاً: قوانین احراز هویت"
                                Class="w-100" />
            </div>

            <div class="col-md-3">
                <label class="form-label fw-semibold">
                    برچسب‌ها (اختیاری)
                </label>
                <TelerikTextBox @bind-Value="_tags"
                                Placeholder="مثلاً: auth,security"
                                Class="w-100" />
            </div>

            <div class="col-md-12">
                <label class="form-label fw-semibold">
                    فایل
                </label>
                <InputFile OnChange="OnFileSelected"
                           class="form-control"
                           accept=".txt,.md,.markdown" />
            </div>
        </div>

        <div class="mt-3 d-flex gap-2 align-items-center">
            <button type="button"
                    class="btn btn-primary"
                    @onclick="UploadAsync"
                    disabled="@(_isUploading || _selectedFile is null)">
                @if (_isUploading)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                }
                else
                {
                    <i class="bi bi-cloud-arrow-up me-1"></i>
                }
                بارگذاری و پردازش
            </button>

            <button type="button"
                    class="btn btn-light"
                    @onclick="OnOpenKnowledgeFilesModal">
                <MaterialIcon IconName="@MaterialIconsHelper.Checklist_rtl"></MaterialIcon>
                فایل‌های دانش
            </button>

            @if (_selectedFile is not null)
            {
                <span class="text-muted small">
                    <i class="bi bi-file-earmark me-1"></i>
                    @_selectedFile.Name
                    (@FormatBytes(_selectedFile.Size))
                </span>
            }
        </div>
    </div>
</div>

<!-- فایل‌های دانش -->
<Modal Buttons="ModalButtons.Close"
       ModalTitle="فایل‌های دانش"
       CloseBtnText="بستن"
       @ref="ModalKnowledgeFiles"
       Size="ModalSize.ExtraLarge">

    <ModalBodyContentHtml>
        @if (_isLoading && _documents is null)
        {
            <div class="p-4 text-center text-muted">
                <div class="spinner-border spinner-border-sm me-2"></div>
                در حال بارگذاری...
            </div>
        }
        else if (_documents is { Count: 0 })
        {
            <div class="p-5 text-center text-muted">
                <i class="bi bi-collection fs-2 d-block mb-2"></i>
                هیچ فایلی بارگذاری نشده است.
            </div>
        }
        else
        {
            <TelerikGrid Data="@_documents"
                         PageSize="10"
                         Navigable="true"
                         Pageable="true"
                         Sortable="true"
                         Resizable="true">

                <RowTemplate Context="doc">
                    <td>
                        <span class="fw-semibold">
                            @doc.OriginalFileName
                        </span>
                    </td>
                    <td>
                        <span class="badge bg-secondary">
                            @doc.DocType.ToDisplay()
                        </span>
                    </td>
                    <td>
                        <span class="text-muted">
                            @(doc.Key ?? "—")
                        </span>
                    </td>
                    <td>
                        @(doc.Category ?? "—")
                    </td>
                    <td>
                        <span class="text-muted">
                            @FormatBytes(doc.FileSize)
                        </span>
                    </td>
                    <td>
                        @doc.ChunkCount
                    </td>
                    <td>
                        @switch (doc.ProcessingStatus)
                        {
                            case "Completed":
                                <span class="badge bg-success">تکمیل شد</span>
                                break;
                            case "Processing":
                                <span class="badge bg-info">در حال پردازش</span>
                                break;
                            case "Failed":
                                <span class="badge bg-danger" title="@doc.ProcessingError">خطا</span>
                                break;
                            default:
                                <span class="badge bg-secondary">@doc.ProcessingStatus</span>
                                break;
                        }
                    </td>
                    <td>
                        <span class="text-muted">
                            @DateTimeTools.GetUnixPersianTime(doc.CreateDateTime).ToNormalPersianDateTime()
                        </span>
                    </td>
                    <td class="text-end">
                        @if (_rebuildTarget?.Id == doc.Id)
                        {
                            <InputFile OnChange="OnRebuildFileSelected"
                                       class="form-control"
                                       accept=".txt,.md,.markdown"
                                       disabled="@_isUploading" />

                            @if (_isUploading)
                            {
                                <div class="mt-2">
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                    در حال بازسازی...
                                </div>
                            }
                        }
                        else
                        {
                            <button type="button"
                                    class="btn btn-sm btn-outline-secondary me-1"
                                    @onclick="() => StartRebuild(doc)"
                                    disabled="@_isUploading">
                                <i class="bi bi-arrow-clockwise me-1"></i>
                                بازسازی
                            </button>

                            <button type="button"
                                    class="btn btn-sm btn-outline-danger"
                                    @onclick="() => DeleteAsync(doc.Id)"
                                    disabled="@_isUploading">
                                <i class="bi bi-trash me-1"></i>
                                حذف
                            </button>
                        }
                    </td>
                </RowTemplate>

                <GridColumns>
                    <GridColumn Field="@nameof(RagDocumentDto.OriginalFileName)" Title="نام فایل" Width="270px" />
                    <GridColumn Field="@nameof(RagDocumentDto.DocType)" Title="نوع" Width="130px" />
                    <GridColumn Field="@nameof(RagDocumentDto.Key)" Title="کلید" Width="160px" />
                    <GridColumn Field="@nameof(RagDocumentDto.Category)" Title="دسته‌بندی" Width="180px" />
                    <GridColumn Field="@nameof(RagDocumentDto.FileSize)" Title="اندازه" Width="75px" />
                    <GridColumn Field="@nameof(RagDocumentDto.ChunkCount)" Title="قطعات" Width="65px" />
                    <GridColumn Field="@nameof(RagDocumentDto.ProcessingStatus)" Title="وضعیت" Width="120px" />
                    <GridColumn Field="@nameof(RagDocumentDto.CreateDateTime)" Title="تاریخ ثبت" Width="180px" />
                    <GridColumn Title="عملیات" Width="250px" />
                </GridColumns>
            </TelerikGrid>
        }
    </ModalBodyContentHtml>
</Modal>

<TelerikDialog @bind-Visible="_showRebuildResult"
               Title="بازسازی فایل"
               Width="300px">
    <DialogContent>
        <div class="text-center">
            <i class="bi bi-check-circle-fill text-success" style="font-size: 36px;"></i>
            <h6 class="fw-bold mt-2 mb-2">بازسازی فایل با موفقیت انجام شد</h6>
            @if (_rebuildChunkCount.HasValue)
            {
                <span class="badge bg-light text-dark border px-2 py-1">
                    تعداد قطعات: @_rebuildChunkCount
                </span>
            }
        </div>
    </DialogContent>
    <DialogButtons>
        <TelerikButton ThemeColor="primary" OnClick="@(() => _showRebuildResult = false)">
            متوجه شدم
        </TelerikButton>
    </DialogButtons>
</TelerikDialog>