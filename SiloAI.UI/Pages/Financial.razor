@page "/financial"
@attribute [Authorize]
@using Telerik.Blazor.Components
@using Telerik.SvgIcons
@using SiloAI.Shared.Tools

<PageTitle>امور مالی — پنل مدیریت هوش مصنوعی سیلو</PageTitle>

@if (IsLoading && _accounts is null)
{
    <div class="p-4">
        <TelerikLoaderContainer LoaderPosition="@LoaderPosition.End"
                                LoaderType="@LoaderType.InfiniteSpinner"
                                Text="@TextResources.APP_StringKeys_Loading">
        </TelerikLoaderContainer>
    </div>
}
else
{    <div class="stat-strip mb-4">
        <div class="stat-card amber">
        <div class="stat-value">
            @((_accounts ?? []).Sum(a => a.BalanceToman).ToString("N0"))
        </div>
        <div class="stat-label">مجموع موجودی حساب‌ها (تومان)</div>
    </div>
    <div class="stat-card">
        <div class="stat-value">
            @((_transactions ?? []).Count(t => t.Type == LedgerTransactionType.TopUp))
        </div>
        <div class="stat-label">شارژهای اخیر</div>
    </div>
    <div class="stat-card">
        <div class="stat-value">
            @((_usageRecords ?? []).Sum(u => u.ChargeToman).ToString("N0"))
        </div>
        <div class="stat-label">مصرف کسرشده اخیر (تومان)</div>
    </div>
</div>
    <div class="card-ai mb-4">
        <div class="card-ai-header">
            <span>
                <i class="bi bi-plus-circle me-2"></i>
                شارژ حساب مشتری
            </span>
        </div>
        <div class="p-4">
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label">مشتری</label>
                    <TelerikDropDownList Data="@(_customers ?? [])"
                                         @bind-Value="_topUpCustomerId"
                                         TextField="Name"
                                         ValueField="Id"
                                         DefaultText="انتخاب مشتری"
                                         Width="100%">
                    </TelerikDropDownList>
                </div>
                <div class="col-md-3">
                    <label class="form-label">مبلغ (تومان)</label>
                    <TelerikNumericTextBox @bind-Value="_topUpAmount"
                                           Min="0m"
                                           Format="N0"
                                           Width="100%" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">مرجع شارژ (شناسه درگاه)</label>
                    <TelerikTextBox @bind-Value="_topUpReference"
                                    Placeholder="مثلاً: pay-123456"
                                    Width="100%" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">توضیح (اختیاری)</label>
                    <TelerikTextBox @bind-Value="_topUpDescription"
                                    Width="100%" />
                </div>
                <div class="col-md-12 d-flex justify-content-end">
                    <TelerikButton OnClick="SubmitTopUp"
                                   Enabled="@(!_isSaving)"
                                   ThemeColor="primary"
                                   Icon="@SvgIcon.Plus">
                        ثبت شارژ
                    </TelerikButton>
                </div>
            </div>
        </div>
    </div>
    <TelerikTabStrip ActiveTabIndex="@_activeTab"
                     ActiveTabIndexChanged="OnTabChanged"
                     Class="card-ai">
        <TabStripTab Title="حساب‌ها">
            <div class="p-3">
                <TelerikGrid Class="grid-center"
                             Data="@(_accounts ?? [])"
                             Pageable="true"
                             PageSize="10"
                             Sortable="true"
                             Resizable="true"
                             Navigable="true">
                    <GridColumns>
                        <GridColumn Field="@nameof(LedgerAccountDto.CustomerName)"
                                    Title="مشتری"
                                    Width="250px">
                            <Template Context="account">
                                @{ var item = (LedgerAccountDto)account; }
                                <span class="fw-medium">@item.CustomerName</span>
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(LedgerAccountDto.BalanceToman)"
                                    Title="موجودی (تومان)"
                                    Width="200px">
                            <Template Context="account">
                                @{ var item = (LedgerAccountDto)account; }
                                <span class="mono fw-bold @(item.BalanceToman <= 0 ? "text-danger" : "text-amber")"
                                      dir="ltr">
                                    @item.BalanceToman.ToString("N0")
                                </span>
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(LedgerAccountDto.UpdatedAt)"
                                    Title="آخرین به‌روزرسانی"
                                    Width="220px">
                            <Template Context="account">
                                @{ var item = (LedgerAccountDto)account; }
                                <span class="mono text-muted">
                                    @DateTimeTools.GetUnixPersianTime(item.UpdatedAt).ToNormalPersianDateTime()
                                </span>
                            </Template>
                        </GridColumn>
                    </GridColumns>
                </TelerikGrid>
            </div>
        </TabStripTab>
        <TabStripTab Title="تراکنش‌ها">
            <div class="p-3">
                <TelerikGrid Class="grid-center"
                             Data="@(_transactions ?? [])"
                             Pageable="true"
                             PageSize="10"
                             Sortable="true"
                             Resizable="true"
                             Navigable="true">
                    <GridColumns>
                        <GridColumn Field="@nameof(LedgerTransactionDto.CustomerName)"
                                    Title="مشتری"
                                    Width="200px">
                            <Template Context="transaction">
                                @{ var item = (LedgerTransactionDto)transaction; }
                                <span class="fw-medium">@item.CustomerName</span>
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(LedgerTransactionDto.Type)"
                                    Title="نوع"
                                    Width="140px">
                            <Template Context="transaction">
                                @{ var item = (LedgerTransactionDto)transaction; }
                                @if (item.Type == LedgerTransactionType.TopUp)
                                {
                                    <span class="badge-active">@item.Type.ToDisplay()</span>
                                }
                                else
                                {
                                    <span class="badge-revoked">@item.Type.ToDisplay()</span>
                                }
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(LedgerTransactionDto.Amount)"
                                    Title="مبلغ (تومان)"
                                    Width="180px">
                            <Template Context="transaction">
                                @{ var item = (LedgerTransactionDto)transaction; }
                                <span class="mono" dir="ltr">@item.Amount.ToString("N0")</span>
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(LedgerTransactionDto.BalanceAfter)"
                                    Title="موجودی پس از تراکنش"
                                    Width="220px">
                            <Template Context="transaction">
                                @{ var item = (LedgerTransactionDto)transaction; }
                                <span class="mono" dir="ltr">@item.BalanceAfter.ToString("N0")</span>
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(LedgerTransactionDto.IdempotencyKey)"
                                    Title="کلید یکتا"
                                    Width="300px">
                            <Template Context="transaction">
                                @{ var item = (LedgerTransactionDto)transaction; }
                                <span class="mono text-muted small" dir="ltr">@item.IdempotencyKey</span>
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(LedgerTransactionDto.CreatedAt)"
                                    Title="تاریخ"
                                    Width="190px">
                            <Template Context="transaction">
                                @{ var item = (LedgerTransactionDto)transaction; }
                                <span class="mono text-muted">
                                    @DateTimeTools.GetUnixPersianTime(item.CreatedAt).ToNormalPersianDateTime()
                                </span>
                            </Template>
                        </GridColumn>
                    </GridColumns>
                </TelerikGrid>
            </div>
        </TabStripTab>
        <TabStripTab Title="سوابق مصرف">
            <div class="p-3">
                <TelerikGrid Class="grid-center"
                             Data="@(_usageRecords ?? [])"
                             Pageable="true"
                             PageSize="10"
                             Sortable="true"
                             Resizable="true"
                             Navigable="true">
                    <GridColumns>
                        <GridColumn Field="@nameof(UsageRecordDto.CustomerName)"
                                    Title="مشتری"
                                    Width="200px">
                            <Template Context="usage">
                                @{ var item = (UsageRecordDto)usage; }
                                <span class="fw-medium">@item.CustomerName</span>
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(UsageRecordDto.Feature)"
                                    Title="قابلیت"
                                    Width="150px">
                            <Template Context="usage">
                                @{ var item = (UsageRecordDto)usage; }
                                <span class="badge-neutral">@item.Feature.ToDisplay()</span>
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(UsageRecordDto.Model)"
                                    Title="مدل"
                                    Width="180px">
                            <Template Context="usage">
                                @{ var item = (UsageRecordDto)usage; }
                                <span class="mono text-muted small" dir="ltr">@item.Model</span>
                            </Template>
                        </GridColumn>
                        <GridColumn Title="توکن‌ها (ورودی/کش/خروجی)"
                                    Width="230px">
                            <Template Context="usage">
                                @{ var item = (UsageRecordDto)usage; }
                                <span class="mono" dir="ltr">
                                    @item.InputTokens / @item.CachedTokens / @item.OutputTokens
                                </span>
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(UsageRecordDto.CostUsd)"
                                    Title="هزینه (دلار)"
                                    Width="160px">
                            <Template Context="usage">
                                @{ var item = (UsageRecordDto)usage; }
                                <span class="mono" dir="ltr">$@item.CostUsd.ToString("N6")</span>
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(UsageRecordDto.FxRateUsed)"
                                    Title="نرخ ارز"
                                    Width="150px">
                            <Template Context="usage">
                                @{ var item = (UsageRecordDto)usage; }
                                <span class="mono" dir="ltr">@item.FxRateUsed.ToString("N0")</span>
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(UsageRecordDto.MultiplierUsed)"
                                    Title="ضریب"
                                    Width="120px">
                            <Template Context="usage">
                                @{ var item = (UsageRecordDto)usage; }
                                <span class="mono" dir="ltr">@item.MultiplierUsed.ToString("N2")</span>
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(UsageRecordDto.ChargeToman)"
                                    Title="کسر نهایی (تومان)"
                                    Width="190px">
                            <Template Context="usage">
                                @{ var item = (UsageRecordDto)usage; }
                                <span class="mono fw-bold" dir="ltr">@item.ChargeToman.ToString("N0")</span>
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(UsageRecordDto.CreatedAt)"
                                    Title="تاریخ"
                                    Width="190px">
                            <Template Context="usage">
                                @{ var item = (UsageRecordDto)usage; }
                                <span class="mono text-muted">
                                    @DateTimeTools.GetUnixPersianTime(item.CreatedAt).ToNormalPersianDateTime()
                                </span>
                            </Template>
                        </GridColumn>
                    </GridColumns>
                </TelerikGrid>
            </div>
        </TabStripTab>
        <TabStripTab Title="قیمت‌گذاری">
            <div class="p-4">
                <div class="row g-3 align-items-end mb-4">
                    <div class="col-md-3">
                        <label class="form-label">قابلیت</label>
                        <TelerikDropDownList Data="@_features"
                                             @bind-Value="_pricingFeature"
                                             Width="100%">
                            <ItemTemplate Context="feature">
                                @feature.ToDisplay()
                            </ItemTemplate>
                            <ValueTemplate Context="feature">
                                @feature.ToDisplay()
                            </ValueTemplate>
                        </TelerikDropDownList>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">ضریب (M)</label>
                        <TelerikNumericTextBox @bind-Value="_pricingMultiplier"
                                               Min="0m"
                                               Format="N2"
                                               Width="100%" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">کف (تومان)</label>
                        <TelerikNumericTextBox @bind-Value="_pricingFloorToman"
                                               Min="0m"
                                               Format="N0"
                                               Width="100%" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">کف (دلار)</label>
                        <TelerikNumericTextBox @bind-Value="_pricingFloorUsd"
                                               Min="0m"
                                               Format="N4"
                                               Width="100%" />
                    </div>
                    <div class="col-md-3 d-flex justify-content-end">
                        <TelerikButton OnClick="SubmitPricingSetting"
                                       Enabled="@(!_isSaving)"
                                       ThemeColor="primary"
                                       Icon="@SvgIcon.Plus">
                            ثبت نسخهٔ جدید
                        </TelerikButton>
                    </div>
                </div>
                <TelerikGrid Class="grid-center"
                             Data="@(_pricingSettings ?? [])"
                             Pageable="true"
                             PageSize="10"
                             Sortable="true"
                             Resizable="true"
                             Navigable="true">
                    <GridColumns>
                        <GridColumn Field="@nameof(PricingSettingDto.Feature)"
                                    Title="قابلیت"
                                    Width="180px">
                            <Template Context="pricing">
                                @{ var item = (PricingSettingDto)pricing; }
                                <span class="badge-neutral">@item.Feature.ToDisplay()</span>
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(PricingSettingDto.Multiplier)"
                                    Title="ضریب (M)"
                                    Width="150px">
                            <Template Context="pricing">
                                @{ var item = (PricingSettingDto)pricing; }
                                <span class="mono" dir="ltr">@item.Multiplier.ToString("N2")</span>
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(PricingSettingDto.FloorToman)"
                                    Title="کف (تومان)"
                                    Width="180px">
                            <Template Context="pricing">
                                @{ var item = (PricingSettingDto)pricing; }
                                <span class="mono" dir="ltr">@item.FloorToman.ToString("N0")</span>
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(PricingSettingDto.FloorUsd)"
                                    Title="کف (دلار)"
                                    Width="160px">
                            <Template Context="pricing">
                                @{ var item = (PricingSettingDto)pricing; }
                                <span class="mono" dir="ltr">$@item.FloorUsd.ToString("N4")</span>
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(PricingSettingDto.EffectiveFrom)"
                                    Title="اعمال از"
                                    Width="190px">
                            <Template Context="pricing">
                                @{ var item = (PricingSettingDto)pricing; }
                                <span class="mono text-muted">
                                    @DateTimeTools.GetUnixPersianTime(item.EffectiveFrom).ToNormalPersianDateTime()
                                </span>
                            </Template>
                        </GridColumn>
                    </GridColumns>
                </TelerikGrid>
            </div>
        </TabStripTab>
        <TabStripTab Title="نرخ ارز">
            <div class="p-4">
                <div class="row g-3 align-items-end mb-4">
                    <div class="col-md-3">
                        <label class="form-label">تومان به ازای هر دلار</label>
                        <TelerikNumericTextBox @bind-Value="_fxTomanPerUsd"
                                               Min="0m"
                                               Format="N0"
                                               Width="100%" />
                    </div>
                    <div class="col-md-3 d-flex justify-content-start">
                        <TelerikButton OnClick="SubmitFxRate"
                                       Enabled="@(!_isSaving)"
                                       ThemeColor="primary"
                                       Icon="@SvgIcon.Plus">
                            ثبت نرخ جدید
                        </TelerikButton>
                    </div>
                </div>
                <TelerikGrid Class="grid-center"
                             Data="@(_fxRates ?? [])"
                             Pageable="true"
                             PageSize="10"
                             Sortable="true"
                             Resizable="true"
                             Navigable="true">
                    <GridColumns>
                        <GridColumn Field="@nameof(FxRateSettingDto.TomanPerUsd)"
                                    Title="نرخ (تومان/دلار)"
                                    Width="220px">
                            <Template Context="rate">
                                @{ var item = (FxRateSettingDto)rate; }
                                <span class="mono fw-bold" dir="ltr">@item.TomanPerUsd.ToString("N0")</span>
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(FxRateSettingDto.EffectiveFrom)"
                                    Title="اعمال از"
                                    Width="220px">
                            <Template Context="rate">
                                @{ var item = (FxRateSettingDto)rate; }
                                <span class="mono text-muted">
                                    @DateTimeTools.GetUnixPersianTime(item.EffectiveFrom).ToNormalPersianDateTime()
                                </span>
                            </Template>
                        </GridColumn>
                    </GridColumns>
                </TelerikGrid>
            </div>
        </TabStripTab>
    </TelerikTabStrip>
}
