@page "/chat"
@using Telerik.Blazor.Components
@using Microsoft.AspNetCore.Components.Forms
@attribute [Authorize]

<div class="rag-chat-page">
    <div class="rag-settings">
        <div class="rag-setting-title">
            <div class="rag-setting-icon">
                <i class="bi bi-sliders2"></i>
            </div>
            <div>
                <div class="rag-setting-heading">
                    تنظیمات جستجو
                </div>
                <div class="rag-setting-description">
                    محدوده و تعداد اسناد مورد استفاده برای پاسخ را مشخص کنید.
                </div>
            </div>
        </div>
        <div class="rag-setting-fields">
           <div class="rag-field">
            <label>  <i class="bi bi-file-earmark-text me-1"></i> نوع سند </label>
              <TelerikDropDownList TItem="RagDocTypeItem"
                           TValue="RagDocType"
                           Data="@_ragDocTypes"
                           TextField="@nameof(RagDocTypeItem.Title)"
                           ValueField="@nameof(RagDocTypeItem.Code)"
                           @bind-Value="_docType"
                           Enabled="@(!_isSending)"
                           Width="100%" />
           </div>
            <div class="rag-field">
                <label> <i class="bi bi-key me-1"></i> کلید </label>
                <input type="text"
                       class="form-control"
                       placeholder="اختیاری"
                       @bind="_key"
                       disabled="@_isSending" />
            </div>
            <div class="rag-field rag-top-k">
                <label>  <i class="bi bi-layers me-1"></i>  تعداد قطعات </label>
                <input type="number"
                       min="1"
                       max="20"
                       class="form-control"
                       @bind="_topK"
                       disabled="@_isSending" />
            </div>
            <div class="rag-setting-action">
                <button class="btn btn-outline-primary rag-new-chat-btn"
                        @onclick="StartNewChat"
                        disabled="@_isSending">
                    <i class="bi bi-plus-lg me-1"></i> گفتگوی جدید
                </button>
            </div>
        </div>
    </div>
    <div class="rag-chat-card">
        <div class="rag-chat-header">
            <div class="rag-chat-header-left">
                <div class="rag-agent-avatar">
                    <i class="bi bi-robot"></i>
                </div>
                <div>
                    <div class="rag-agent-name"> دستیار هوشمند سیلو</div>
                    <div class="rag-agent-status">
                        <span></span>
                        آماده پاسخ‌گویی بر اساس پایگاه دانش
                    </div>
                </div>
            </div>

            @if (_messages.Count > 0)
            {
                <div class="rag-message-count">
                    <i class="bi bi-chat-left-text me-1"></i>
                    @_messages.Count پیام
                </div>
            }
        </div>
        <div class="chat-window rag-chat-window">

            @if (_messages.Count == 0)
            {
                <div class="rag-empty">
                    <div class="rag-empty-orbit">
                        <div class="rag-empty-icon">
                            <i class="bi bi-stars"></i>
                        </div>
                    </div>
                    <div class="rag-empty-title">
                        آماده گفتگو هستم
                    </div>
                    <div class="rag-empty-description">
                        پرسش خود را درباره اطلاعات موجود در پایگاه دانش بنویسید.
                        پاسخ‌ها بر اساس اسناد ایندکس‌شده تولید می‌شوند.
                    </div>
                    <div class="rag-suggestions">
                        <div class="rag-suggestion">
                            <i class="bi bi-search"></i>
                            جستجو در اسناد
                        </div>
                        <div class="rag-suggestion">
                            <i class="bi bi-file-text"></i>
                            بررسی محتوای مستندات
                        </div>
                        <div class="rag-suggestion">
                            <i class="bi bi-diagram-3"></i>
                            تحلیل اطلاعات
                        </div>
                    </div>
                </div>
            }

            else
            {
                @foreach (var msg in _messages)
                {
                    <div class="chat-row @(msg.IsUser ? "chat-row-user" : "chat-row-bot")">
                        @if (!msg.IsUser)
                        {
                            <div class="rag-message-avatar">
                                <i class="bi bi-robot"></i>
                            </div>
                        }
                        <div class="chat-bubble @(msg.IsUser ? "chat-bubble-user" : "chat-bubble-bot")">
                            <div class="chat-bubble-header">
                                <div class="chat-sender">
                                    <span>
                                        @(msg.IsUser ? "شما" : "دستیار هوشمند")
                                    </span>
                                </div>
                                <span class="chat-time mono" dir="ltr">
                                   @msg.Time.ToLocalTime().ToString("HH:mm")
                               </span>
                            </div>
                            <div class="chat-bubble-body">
                                @msg.Text
                            </div>

                            @if (msg.IsUser && msg.AttachmentNames is { Count: > 0 })
                            {
                                <div class="chat-bubble-attachments">
                                    @foreach (var name in msg.AttachmentNames)
                                    {
                                        <span class="chat-bubble-attachment" title="@name">
                                            <i class="bi bi-paperclip"></i>
                                            <span>@name</span>
                                        </span>
                                    }
                                </div>
                            }

                            @if (!msg.IsUser && msg.Citations is { Count: > 0 })
                            {
                                <div class="chat-citations">
                                    <div class="chat-citations-title">
                                        <div class="citation-title-left">
                                            <div class="citation-icon">
                                                <i class="bi bi-bookmark-star-fill"></i>
                                            </div>
                                            <span>
                                                منابع پاسخ
                                            </span>
                                        </div>
                                        <span class="citation-count">
                                            @msg.Citations.Count منبع
                                        </span>
                                    </div>
                                    <div class="citation-list">
                                        @for (var i = 0; i < msg.Citations.Count; i++)
                                        {
                                            var c = msg.Citations[i];
                                            var idx = i + 1;
                                            <div class="chat-citation">
                                                <div class="chat-citation-number mono">
                                                    @idx
                                                </div>
                                                <div class="chat-citation-content">
                                                    <div class="chat-citation-meta">
                                                        <span class="chat-citation-file">
                                                            <i class="bi bi-file-earmark-text me-1"></i>
                                                            @c.FileName
                                                        </span>
                                                       <span class="chat-citation-chunk">
                                                            قطعه <span class="mono">@c.ChunkIndex</span>
                                                       </span>
                                                        <span class="chat-citation-score">
                                                           <i class="bi bi-bullseye me-1"></i>
                                                           <span class="mono">@c.Similarity.ToString("F3")</span>
                                                        </span>
                                                    </div>
                                                    <div class="chat-citation-snippet">
                                                        @c.Snippet
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

               @if (_isSending)
               {
                  <div class="chat-row chat-row-bot">
                    <div class="rag-message-avatar">
                     <i class="bi bi-robot"></i>
                 </div>
                <div class="chat-bubble chat-bubble-bot rag-thinking-bubble">
                  <TelerikLoaderContainer LoaderPosition="@LoaderPosition.End"
                                    LoaderType="@LoaderType.InfiniteSpinner"
                                    Text="در حال بررسی پایگاه دانش و آماده‌سازی پاسخ...">
                  </TelerikLoaderContainer>
                 </div>
               </div>
             }
            }
        </div>
        <div class="rag-input-area">
            @if (_attachments.Count > 0)
            {
                <div class="rag-attachments">
                    @foreach (var attachment in _attachments)
                    {
                        <div class="rag-attachment">
                            @if (attachment.Preview is not null)
                            {
                                <img class="rag-attachment-thumb" src="@attachment.Preview" alt="@attachment.Name" />
                            }
                            else
                            {
                                <span class="rag-attachment-icon">
                                    <i class="bi @AttachmentIcon(attachment.Kind)"></i>
                                </span>
                            }
                            <div class="rag-attachment-info">
                                <div class="rag-attachment-name" title="@attachment.Name">@attachment.Name</div>
                                <div class="rag-attachment-size mono" dir="ltr">@FormatBytes(attachment.Size)</div>
                            </div>
                            <button type="button"
                                    class="rag-attachment-remove"
                                    title="حذف فایل"
                                    @onclick="() => RemoveAttachment(attachment)"
                                    disabled="@_isSending">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                    }
                </div>
            }
            <div class="rag-input-wrapper">
                <label class="rag-attach-btn @(_isSending || _attachments.Count >= MaxFiles ? "disabled" : "")"
                       title="پیوست فایل (حداکثر @MaxFiles فایل)">
                    <i class="bi bi-paperclip"></i>
                    <InputFile OnChange="OnFilesSelected"
                               class="d-none"
                               multiple
                               accept="@AcceptAttribute"
                               disabled="@(_isSending || _attachments.Count >= MaxFiles)" />
                </label>
                <textarea class="form-control rag-textarea"
                          rows="2"
                          placeholder="پرسش خود را درباره پایگاه دانش بنویسید..."
                          @bind="_input"
                          @bind:event="oninput"
                          @onkeydown="OnInputKeyDown"
                          disabled="@_isSending"></textarea>
                <button class="rag-send-btn"
                        @onclick="SendAsync"
                        disabled="@(_isSending || string.IsNullOrWhiteSpace(_input))">
                   @if (_isSending)
                  {
                      <TelerikLoader Type="@LoaderType.InfiniteSpinner" />
                  }
                 else
                  {
                     <i class="bi bi-arrow-up"></i>
                  }
                </button>
            </div>
            <div class="rag-input-hint">
                <span>
                    <kbd>Enter</kbd>
                    ارسال
                </span>
                <span>
                    <kbd>Shift</kbd> + <kbd>Enter</kbd>
                    خط جدید
                </span>
                <span class="rag-attach-hint">
                    <i class="bi bi-paperclip me-1"></i>
                    پیوست اختیاری: حداکثر @MaxFiles فایل، هر فایل تا @MaxFileMegabytes مگابایت
                    (<span class="mono" dir="ltr">@AllowedExtensionsText</span>)
                </span>
                <span class="rag-input-security">
                    <i class="bi bi-shield-check me-1"></i>
                    پاسخ مبتنی بر اسناد
                </span>
            </div>
        </div>
    </div>
</div>