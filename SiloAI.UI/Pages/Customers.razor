@page "/customers"
@attribute [Authorize]

@using SiloAI.Shared.Tools
@using Telerik.Blazor
@using Telerik.Blazor.Components
@using Telerik.SvgIcons

<PageTitle>مشتریان — پنل مدیریت هوش مصنوعی سیلو</PageTitle>

    @if (_showApiKeys && _selectedCustomer is not null)
    {
        <div class="card-ai mb-4">
            <div class="card-ai-header">
                <span>
                    <i class="bi bi-arrow-right-circle me-2"></i>
                    کلیدهای API مشتری: @_selectedCustomer.Name
                </span>
                <button class="btn btn-sm btn-outline-secondary"
                        @onclick="() =>
                                    {
                                        _showApiKeys = false;
                                        _selectedCustomer = null;
                                    }">
                    <i class="bi bi-x me-1"></i>
                    بستن
                </button>
            </div>
            <div class="p-4">
                @if (!string.IsNullOrEmpty(_newKeyValue))
                {
                    <div class="alert alert-success d-flex gap-3 align-items-start">
                        <i class="bi bi-check-circle-fill fs-5 mt-1"></i>
                        <div>
                            <strong>
                                کلید ایجاد شد — همین الان کپی کنید، دیگر نمایش داده نمی‌شود.
                            </strong>
                            <div class="customer-api-key mono" dir="ltr">
                                @_newKeyValue
                            </div>
                            <small class="text-muted">
                                این مقدار را در هدر <code>X-Api-Key</code> مصرف‌کننده API قرار دهید.
                            </small>
                        </div>
                    </div>
                }
                <div class="row g-3 align-items-end mb-4">
                    <div class="col-md-5">
                        <label class="form-label fw-semibold">
                            عنوان کلید
                        </label>
                        <input type="text"
                               class="form-control"
                               placeholder="مثلاً: اپلیکیشن موبایل"
                               @bind="_newKeyLabel" />

                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">
                            تاریخ انقضا
                        </label>
                        <input type="date"
                               class="form-control"
                               @bind="_newKeyExpiresAt" />
                    </div>
                    <div class="col-md-3">
                        <button class="btn btn-primary w-100"
                                @onclick="CreateApiKey"
                                disabled="@_isKeyLoading">

                            @if (_isKeyLoading)
                            {
                                <TelerikLoader Type="@LoaderType.InfiniteSpinner" />
                            }
                            else
                            {
                                <i class="bi bi-plus-lg me-1"></i>
                            }
                            ایجاد کلید
                        </button>
                    </div>
                </div>

                @if (_customerKeys is { Count: 0 })
                {
                    <div class="text-center text-muted py-4">
                        <i class="bi bi-key me-2"></i>
                        هیچ کلید API‌ای وجود ندارد.
                    </div>
                }
                else
                {
                    <TelerikGrid Data="@(_customerKeys ?? [])"
                                 TItem="ApiKeyDto"
                                 Class="customers-grid"
                                 Pageable="true"
                                 PageSize="10"
                                 Sortable="true"
                                 Resizable="true"
                                 Navigable="true">
                        <GridColumns>
                            <GridColumn Field="@nameof(ApiKeyDto.Label)"
                                        Title="عنوان"
                                        Width="250px" />
                            <GridColumn Field="@nameof(ApiKeyDto.CreatedAt)"
                                        Title="تاریخ ایجاد"
                                        Width="190px">
                                <Template Context="context">
                                    @{
                                        var key = (ApiKeyDto)context;
                                    }
                                    <span class="text-muted mono">
                                        @DateTimeTools.GetUnixPersianTime(key.CreatedAt).ToNormalPersianDateTime()
                                    </span>
                                </Template>
                            </GridColumn>
                            <GridColumn Field="@nameof(ApiKeyDto.ExpiresAt)"
                                        Title="تاریخ انقضا"
                                        Width="180px">
                                <Template Context="context">
                                    @{
                                        var key = (ApiKeyDto)context;
                                    }
                                    <span class="text-muted mono">
                                        @DateTimeTools.GetUnixPersianTime(key.ExpiresAt).ToNormalPersianDateTime()
                                    </span>
                                </Template>
                            </GridColumn>
                            <GridColumn Title="وضعیت"
                                        Width="140px">
                                <Template Context="context">
                                    @{
                                        var key = (ApiKeyDto)context;
                                    }
                                    @if (key.IsRevoked)
                                    {
                                        <span class="badge-revoked">
                                            لغو شده
                                        </span>
                                    }
                                    else if (key.ExpiresAt < DateTime.Now)
                                    {
                                        <span class="badge-expired">
                                            منقضی
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-active">
                                            فعال
                                        </span>
                                    }
                                </Template>
                            </GridColumn>
                            <GridColumn Title="عملیات"
                                        Width="140px">
                                <Template Context="context">
                                    @{
                                        var key = (ApiKeyDto)context;
                                    }

                                    @if (!key.IsRevoked)
                                    {
                                        <button class="btn btn-sm btn-outline-danger"
                                                @onclick="() => RevokeApiKey(key.Id)"
                                                disabled="@_isKeyLoading">
                                            <i class="bi bi-x-circle me-1"></i>
                                            لغو
                                        </button>
                                    }
                               </Template>
                            </GridColumn>
                        </GridColumns>
                   </TelerikGrid>
                }
            </div>
        </div>
    }
    else
    {
        <div class="card-ai">
            <div class="card-ai-header">
                <span>
                    <i class="bi bi-people me-2"></i>
                    مشتریان
                    <span class="text-muted small ms-2">@(_customers?.Count ?? 0) مشتری</span>
                </span>
                <TelerikButton ThemeColor="primary"
                               Icon="@SvgIcon.Plus"
                               OnClick="OpenCreate">
                    مشتری جدید
                </TelerikButton>
            </div>
            @if (IsLoading && _customers is null)
            {
                <div class="p-4">
                    <TelerikLoaderContainer LoaderPosition="@LoaderPosition.End"
                                            LoaderType="@LoaderType.InfiniteSpinner"
                                            Text="@TextResources.APP_StringKeys_Loading">
                    </TelerikLoaderContainer>
                </div>
            }
            else
            {
                <TelerikGrid Data="@(_customers ?? [])"
                             TItem="CustomerDto"
                             Class="customers-grid"
                             Pageable="true"
                             PageSize="10"
                             Sortable="true"
                             Resizable="true"
                             Navigable="true">
                    <GridColumns>
                        <GridColumn Field="@nameof(CustomerDto.Name)"
                                    Title="مشتری"
                                    Width="260px">
                            <Template Context="context">
                                @{
                                    var customer = (CustomerDto)context;
                                }
                                <div class="fw-semibold">@customer.Name</div>
                                <div class="text-muted small mono" dir="ltr">
                                    @DateTimeTools.GetUnixPersianTime(customer.CreatedAt).ToNormalPersianDateTime()
                                </div>
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(CustomerDto.BalanceToman)"
                                    Title="اعتبار باقیمانده (تومان)"
                                    Width="220px">
                            <Template Context="context">
                                @{
                                    var customer = (CustomerDto)context;
                                }
                                <a href="/financial" class="text-decoration-none" title="مدیریت اعتبار در صفحه مالی">
                                    <span class="mono customer-credit @(customer.BalanceToman < 0 ? "customer-credit-negative" : "")"
                                          dir="ltr">
                                        @customer.BalanceToman.ToString("N0")
                                    </span>
                                </a>
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(CustomerDto.Multiplier)"
                                    Title="ضریب"
                                    Width="120px">
                            <Template Context="context">
                                @{
                                    var customer = (CustomerDto)context;
                                }
                                <span class="mono" dir="ltr">× @customer.Multiplier.ToString("0.##")</span>
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(CustomerDto.StopOnInsufficientCredit)"
                                    Title="در صورت اتمام اعتبار"
                                    Width="190px">
                            <Template Context="context">
                                @{
                                    var customer = (CustomerDto)context;
                                }
                                @if (customer.StopOnInsufficientCredit)
                                {
                                    <span class="badge-revoked">توقف استفاده</span>
                                }
                                else
                                {
                                    <span class="badge-active">اعتبار منفی مجاز</span>
                                }
                            </Template>
                        </GridColumn>
                        <GridColumn Title="عملیات"
                                    Width="300px">
                            <Template Context="context">
                                @{
                                    var customer = (CustomerDto)context;
                                }
                                <div class="customers-actions">
                                    <TelerikButton Size="@ThemeConstants.Button.Size.Small"
                                                   FillMode="@ThemeConstants.Button.FillMode.Outline"
                                                   ThemeColor="primary"
                                                   Icon="@SvgIcon.Pencil"
                                                   OnClick="() => StartEdit(customer)">
                                        ویرایش
                                    </TelerikButton>
                                    <TelerikButton Size="@ThemeConstants.Button.Size.Small"
                                                   FillMode="@ThemeConstants.Button.FillMode.Outline"
                                                   ThemeColor="info"
                                                   Icon="@SvgIcon.Lock"
                                                   OnClick="() => ShowApiKeys(customer)">
                                        کلیدهای API
                                    </TelerikButton>
                                    <TelerikButton Size="@ThemeConstants.Button.Size.Small"
                                                   FillMode="@ThemeConstants.Button.FillMode.Outline"
                                                   ThemeColor="error"
                                                   Icon="@SvgIcon.Trash"
                                                   Enabled="@(!IsLoading)"
                                                   OnClick="() => DeleteCustomer(customer.Id)">
                                        حذف
                                    </TelerikButton>
                                </div>
                            </Template>
                        </GridColumn>
                    </GridColumns>
                </TelerikGrid>
            }
        </div>
    }

<TelerikDialog @bind-Visible="_showCreate"
               Title="مشتری جدید"
               Width="520px">
    <DialogContent>
        <div class="customer-form">
            <div class="customer-form-section">اطلاعات پایه</div>
            <label class="form-label fw-semibold">نام مشتری</label>
            <input type="text"
                   class="form-control mb-3"
                   placeholder="نام مشتری را وارد کنید"
                   @bind="_newName" />

            <div class="customer-form-section">اعتبار و قیمت‌گذاری</div>
            <label class="form-label fw-semibold">اعتبار اولیه (تومان)</label>
            <TelerikNumericTextBox @bind-Value="_newCredit" Min="0m" Format="N0" Width="100%" />
            <small class="text-muted d-block mb-3">به‌عنوان اولین شارژ در دفتر مالی ثبت می‌شود.</small>

            <label class="form-label fw-semibold">ضریب</label>
            <TelerikNumericTextBox @bind-Value="_newMultiplier" Min="0m" Format="N2" Width="100%" />
            <small class="text-muted d-block mb-3">هزینه‌ی هر درخواست = هزینه‌ی دلاری × نرخ دلار × ضریب.</small>

            <div class="d-flex align-items-center gap-2">
                <TelerikCheckBox @bind-Value="_newStopOnInsufficientCredit" Id="newStopOnInsufficientCredit" />
                <label for="newStopOnInsufficientCredit">با اتمام اعتبار، استفاده متوقف شود</label>
            </div>
            <small class="text-muted d-block">اگر فعال نباشد، اعتبار این مشتری می‌تواند منفی شود.</small>
        </div>
    </DialogContent>
    <DialogButtons>
        <TelerikButton ThemeColor="primary" Enabled="@(!IsLoading)" OnClick="CreateCustomer">ثبت مشتری</TelerikButton>
        <TelerikButton OnClick="() => _showCreate = false">انصراف</TelerikButton>
    </DialogButtons>
</TelerikDialog>

<TelerikDialog @bind-Visible="_showEdit"
               Title="ویرایش مشتری"
               Width="520px">
    <DialogContent>
        <div class="customer-form">
            <label class="form-label fw-semibold">نام مشتری</label>
            <input type="text" class="form-control mb-3" @bind="_editName" />

            <label class="form-label fw-semibold">ضریب</label>
            <TelerikNumericTextBox @bind-Value="_editMultiplier" Min="0m" Format="N2" Width="100%" />
            <small class="text-muted d-block mb-3">هزینه‌ی هر درخواست = هزینه‌ی دلاری × نرخ دلار × ضریب.</small>

            <div class="d-flex align-items-center gap-2">
                <TelerikCheckBox @bind-Value="_editStopOnInsufficientCredit" Id="editStopOnInsufficientCredit" />
                <label for="editStopOnInsufficientCredit">با اتمام اعتبار، استفاده متوقف شود</label>
            </div>
            <small class="text-muted d-block">اگر فعال نباشد، اعتبار این مشتری می‌تواند منفی شود.</small>
        </div>
    </DialogContent>
    <DialogButtons>
        <TelerikButton ThemeColor="primary" Enabled="@(!IsLoading)" OnClick="SaveEdit">ذخیره</TelerikButton>
        <TelerikButton OnClick="CancelEdit">انصراف</TelerikButton>
    </DialogButtons>
</TelerikDialog>
