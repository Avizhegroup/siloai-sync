@page "/"
@attribute [Authorize]

<PageTitle>خانه — پنل مدیریت هوش مصنوعی سیلو</PageTitle>

<div class="card-ai mb-4">
    <div class="p-4">
        <div class="d-flex align-items-center gap-3">
            <i class="bi bi-robot" style="font-size: 2.5rem; color: var(--accent);"></i>
            <div>
                <h4 class="mb-0 fw-bold">خوش آمدید به پنل مدیریت هوش مصنوعی سیلو</h4>
                <p class="text-muted mb-0">مدیریت مشتریان، کلیدهای API و پایش سرویس هوش مصنوعی.</p>
            </div>
        </div>
    </div>
</div>

@if (_isLoading)
{
    <div class="d-flex align-items-center gap-2 text-muted mb-4">
        <div class="spinner-border spinner-border-sm"></div>
        <span>در حال بارگذاری...</span>
    </div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="stat-card d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-value">@_totalCustomers</div>
                    <div class="stat-label">کل مشتریان</div>
                </div>
                <i class="bi bi-people-fill stat-icon"></i>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-value text-success">@_activeKeys</div>
                    <div class="stat-label">کلیدهای API فعال</div>
                </div>
                <i class="bi bi-key-fill stat-icon text-success"></i>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-value">@_totalKeys</div>
                    <div class="stat-label">کل کلیدهای API</div>
                </div>
                <i class="bi bi-key stat-icon"></i>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-value text-danger">@_revokedKeys</div>
                    <div class="stat-label">کلیدهای لغو شده</div>
                </div>
                <i class="bi bi-shield-x stat-icon text-danger"></i>
            </div>
        </div>
    </div>


    <div class="card-ai">
        <div class="card-ai-header">
            <span><i class="bi bi-clock-history me-2"></i>آخرین کلیدهای ایجاد شده</span>
            <a href="/customers" class="btn btn-sm btn-outline-primary">
                <i class="bi bi-arrow-left me-1"></i>مدیریت همه
            </a>
        </div>
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>عنوان</th>
                        <th>مشتری</th>
                        <th>تاریخ ایجاد</th>
                        <th>تاریخ انقضا</th>
                        <th>وضعیت</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_recentKeys is { Count: 0 })
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                <i class="bi bi-key me-2"></i>هیچ کلید API‌ای وجود ندارد.
                                <a href="/customers">ایجاد کنید</a>
                            </td>
                        </tr>
                    }
                    @foreach (var key in _recentKeys ?? [])
                    {
                        <tr>
                            <td class="fw-semibold">@key.Label</td>
                            <td class="text-muted">@(_customerMap.TryGetValue(key.CustomerId ?? 0, out var name) ? name : "—")</td>
                            <td class="text-muted">@key.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd")</td>
                            <td class="text-muted">@key.ExpiresAt.ToLocalTime().ToString("yyyy/MM/dd")</td>
                            <td>
                                @if (key.IsRevoked)
                                {
                                    <span class="badge-revoked">لغو شده</span>
                                }
                                else if (key.ExpiresAt < DateTime.UtcNow)
                                {
                                    <span class="badge-expired">منقضی</span>
                                }
                                else
                                {
                                    <span class="badge-active">فعال</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
