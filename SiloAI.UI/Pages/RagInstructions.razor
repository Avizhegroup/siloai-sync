@page "/rag-instructions"
@attribute [Authorize]
@using Microsoft.AspNetCore.Components.Forms
@using Telerik.Blazor.Components
@using SiloAI.Shared.Tools
@using SiloAI.UI.Components

<PageTitle>دستورالعمل‌ها — پنل مدیریت هوش مصنوعی سیلو</PageTitle>

<Modal Buttons="ModalButtons.Close"
       ModalTitle="دستورالعمل‌ها"
       CloseBtnText="بستن"
       @ref="ModalInstructions"
       Size="ModalSize.ExtraLarge">
    <ModalBodyContentHtml>
        @if (IsLoading && Instructions is null)
        {
            <div class="p-4 text-center text-muted">
                <div class="spinner-border spinner-border-sm me-2"></div>
                در حال بارگذاری...
            </div>
        }
        else if (Instructions is { Count: 0 })
        {
            <div class="p-5 text-center text-muted">
                <i class="bi bi-card-checklist fs-2 d-block mb-2"></i>
                هیچ دستورالعملی ثبت نشده است.
            </div>
        }
        else
        {
            <TelerikGrid Data="@Instructions"
                         PageSize="10"
                         Pageable="true"
                         Sortable="true"
                         Resizable="true"
                         Navigable="true">
                <RowTemplate Context="instruction">
                    <td>
                        <span class="badge bg-secondary">
                            @instruction.DocType.ToDisplay()
                        </span>
                    </td>
                    <td>
                        <span class="text-muted">
                            @(instruction.Key ?? "—")
                        </span>
                    </td>
                    <td>
                        @(instruction.Category ?? "—")
                    </td>
                    <td>
                        <span class="text-muted">
                            @(instruction.Tags ?? "—")
                        </span>
                    </td>
                    <td>
                        @if (instruction.IsActive)
                        {
                            <span class="badge bg-success">فعال</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">غیرفعال</span>
                        }
                    </td>
                    <td>
                        <span class="text-muted">
                            @DateTimeTools.GetUnixPersianTime(instruction.CreateDateTime).ToNormalPersianDateTime()
                        </span>
                    </td>
                    <td>
                        <span class="text-muted">
                            @(
                                instruction.LastUpdateDateTime.HasValue
                                    ? DateTimeTools
                                        .GetUnixPersianTime(instruction.LastUpdateDateTime.Value)
                                        .ToNormalPersianDateTime()
                                    : "—"
                            )
                        </span>
                    </td>
                    <td class="text-end">
                        <button type="button"
                                class="btn btn-sm btn-outline-secondary me-1"
                                @onclick="() => StartEdit(instruction)"
                                disabled="@IsSaving">
                            <i class="bi bi-pencil me-1"></i>
                            ویرایش
                        </button>
                        <button type="button"
                                class="btn btn-sm btn-outline-danger"
                                @onclick="() => DeleteAsync(instruction.Id)"
                                disabled="@IsSaving">
                            <i class="bi bi-trash me-1"></i>
                            حذف
                        </button>
                    </td>
                </RowTemplate>
                <GridColumns>
                    <GridColumn Field="@nameof(RagInstructionDto.DocType)" Title="نوع" Width="130px" />
                    <GridColumn Field="@nameof(RagInstructionDto.Key)" Title="کلید" Width="160px" />
                    <GridColumn Field="@nameof(RagInstructionDto.Category)" Title="دسته‌بندی" Width="180px" />
                    <GridColumn Field="@nameof(RagInstructionDto.Tags)" Title="برچسب‌ها" Width="180px" />
                    <GridColumn Field="@nameof(RagInstructionDto.IsActive)" Title="وضعیت" Width="100px" />
                    <GridColumn Field="@nameof(RagInstructionDto.CreateDateTime)" Title="تاریخ ثبت" Width="180px" />
                    <GridColumn Field="@nameof(RagInstructionDto.LastUpdateDateTime)" Title="آخرین به‌روزرسانی" Width="180px" />
                    <GridColumn Title="عملیات" Width="230px" />
                </GridColumns>
            </TelerikGrid>
        }
    </ModalBodyContentHtml>
</Modal>

<div class="card-ai mb-4 shadow-sm border-0">
    <div class="card-ai-header d-flex align-items-center justify-content-between py-3">
        <div class="d-flex align-items-center gap-2">
            <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-2">
                <i class="bi bi-card-checklist fs-5"></i>
            </div>
            <div>
                <span class="fw-semibold d-block">
                    @(EditingId is null ? "افزودن دستورالعمل جدید" : "ویرایش دستورالعمل")
                </span>
            </div>
        </div>

        @if (EditingId is not null)
        {
            <button class="btn btn-sm btn-outline-secondary" @onclick="ResetForm">
                <i class="bi bi-x-lg me-1"></i>
                انصراف
            </button>
        }
    </div>

    <div class="p-3">
        <div class="row g-2">
            <div class="col-md-3">
                <label class="form-label fw-semibold text-secondary small mb-1">نوع سند</label>
                <TelerikDropDownList Data="@DocTypes"
                                     @bind-Value="Request.DocType"
                                     TextField="Title"
                                     ValueField="Code"
                                     Enabled="@(EditingId is null)"
                                     Class="w-100" />
            </div>

            <div class="col-md-3">
                <label class="form-label fw-semibold text-secondary small mb-1">
                    کلید <span class="text-muted fw-normal">(اختیاری)</span>
                </label>
                <TelerikTextBox @bind-Value="Request.Key"
                                Placeholder="مثلاً: hr-policy-2025"
                                Class="w-100" />
            </div>

            <div class="col-md-3">
                <label class="form-label fw-semibold text-secondary small mb-1">دسته‌بندی</label>
                <TelerikTextBox @bind-Value="Request.Category"
                                Placeholder="مثلاً: قوانین احراز هویت"
                                Class="w-100" />
            </div>

            <div class="col-md-3">
                <label class="form-label fw-semibold text-secondary small mb-1">
                    برچسب‌ها <span class="text-muted fw-normal">(اختیاری)</span>
                </label>
                <TelerikTextBox @bind-Value="Request.Tags"
                                Placeholder="مثلاً: auth,security"
                                Class="w-100" />
            </div>

            <div class="col-12">
                <label class="form-label fw-semibold text-secondary small mb-1">
                    بارگذاری فایل متنی <span class="text-muted fw-normal">(اختیاری)</span>
                </label>

                <div class="border border-2 border-dashed rounded-3 px-3 py-2 bg-light d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-file-earmark-text text-primary opacity-75"></i>
                        <span class="small">فایل متنی را انتخاب کنید</span>
                    </div>
                    <label class="btn btn-outline-primary btn-sm mb-0">
                        <i class="bi bi-folder2-open me-1"></i>
                        انتخاب فایل
                        <InputFile OnChange="OnFileSelected"
                                   class="d-none"
                                   accept=".txt,.md,.markdown" />
                    </label>
                </div>
            </div>

            <div class="col-12">
                <label class="form-label fw-semibold text-secondary small mb-1">محتوای دستورالعمل</label>
                <div class="border rounded-3 overflow-hidden">
                    <TelerikEditor @bind-Value="Request.Content"
                                   Height="300px" />
                </div>
            </div>

            <div class="col-12 mt-1">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div class="d-flex flex-wrap gap-4">
                        <div class="form-check mb-0">
                            <input type="checkbox"
                                   class="form-check-input"
                                   id="isSystematicCheck"
                                   @bind="Request.IsSystematic" />
                            <label class="form-check-label fw-semibold"
                                   for="isSystematicCheck">
                                سیستماتیک
                            </label>
                        </div>

                        @if (EditingId is not null)
                        {
                            <div class="form-check mb-0">
                                <input type="checkbox"
                                       class="form-check-input"
                                       id="isActiveCheck"
                                       @bind="Request.IsActive" />
                                <label class="form-check-label fw-semibold"
                                       for="isActiveCheck">
                                    فعال
                                </label>
                            </div>
                        }
                    </div>

                    <div class="d-flex gap-2">
                        <button type="button"
                                class="btn btn-primary px-4"
                                @onclick="SaveAsync"
                                disabled="@(IsSaving || string.IsNullOrWhiteSpace(Request.Content))">
                            @if (IsSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                <span>در حال ذخیره...</span>
                            }
                            else
                            {
                                <i class="bi bi-check2 me-1"></i>
                                <span>@(EditingId is null ? "ذخیره" : "به‌روزرسانی")</span>
                            }
                        </button>

                        <button type="button"
                                class="btn btn-outline-secondary"
                                @onclick="OpenInstructionsModal"
                                disabled="@IsSaving">
                            <i class="bi bi-card-checklist me-1"></i>
                            نمایش دستورالعمل‌ها
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>