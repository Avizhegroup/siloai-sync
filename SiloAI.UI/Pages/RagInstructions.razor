@page "/rag-instructions"
@attribute [Authorize]
@using Microsoft.AspNetCore.Components.Forms
@using Telerik.Blazor.Components
@using SiloAI.Shared.Tools
@using SiloAI.UI.Components

<PageTitle>دستورالعمل‌ها — پنل مدیریت هوش مصنوعی سیلو</PageTitle>


<Modal Buttons="ModalButtons.Close"
       ModalTitle="دستورالعمل‌ها"
       CloseBtnText="بستن"
       @ref="ModalInstructions"
       Size="ModalSize.ExtraLarge">

    <ModalBodyContentHtml>

        @if (IsLoading && Instructions is null)
        {
            <div class="p-4 text-center text-muted">
                <div class="spinner-border spinner-border-sm me-2"></div>
                در حال بارگذاری...
            </div>
        }
        else if (Instructions is { Count: 0 })
        {
            <div class="p-5 text-center text-muted">
                <i class="bi bi-card-checklist fs-2 d-block mb-2"></i>
                هیچ دستورالعملی ثبت نشده است.
            </div>
        }
        else
        {
            <TelerikGrid Data="@Instructions"
                         PageSize="10"
                         Pageable="true"
                         Sortable="true"
                         Resizable="true"
                         Navigable="true">

                <RowTemplate Context="instruction">

                    <td>
                        <span class="badge bg-secondary">
                            @instruction.DocType.ToDisplay()
                        </span>
                    </td>

                    <td>
                        <span class="text-muted">
                            @(instruction.Key ?? "—")
                        </span>
                    </td>

                    <td>
                        @(instruction.Category ?? "—")
                    </td>

                    <td>
                        <span class="text-muted">
                            @(instruction.Tags ?? "—")
                        </span>
                    </td>

                    <td>
                        @if (instruction.IsActive)
                        {
                            <span class="badge bg-success">
                                فعال
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                غیرفعال
                            </span>
                        }
                    </td>

                    <td>
                        <span class="text-muted">
                            @DateTimeTools.GetUnixPersianTime(instruction.CreateDateTime).ToNormalPersianDateTime()
                        </span>
                    </td>

                    <td>
                        <span class="text-muted">
                            @(
                                instruction.LastUpdateDateTime.HasValue
                                    ? DateTimeTools
                                        .GetUnixPersianTime(instruction.LastUpdateDateTime.Value)
                                        .ToNormalPersianDateTime()
                                    : "—"
                            )
                        </span>
                    </td>

                    <td class="text-end">

                        <button type="button"
                                class="btn btn-sm btn-outline-secondary me-1"
                                @onclick="() => StartEdit(instruction)"
                                disabled="@IsSaving">

                            <i class="bi bi-pencil me-1"></i>
                            ویرایش

                        </button>

                        <button type="button"
                                class="btn btn-sm btn-outline-danger"
                                @onclick="() => DeleteAsync(instruction.Id)"
                                disabled="@IsSaving">

                            <i class="bi bi-trash me-1"></i>
                            حذف

                        </button>

                    </td>

                </RowTemplate>

                <GridColumns>

                    <GridColumn Field="@nameof(RagInstructionDto.DocType)"
                                Title="نوع"
                                Width="130px" />

                    <GridColumn Field="@nameof(RagInstructionDto.Key)"
                                Title="کلید"
                                Width="160px" />

                    <GridColumn Field="@nameof(RagInstructionDto.Category)"
                                Title="دسته‌بندی"
                                Width="180px" />

                    <GridColumn Field="@nameof(RagInstructionDto.Tags)"
                                Title="برچسب‌ها"
                                Width="180px" />

                    <GridColumn Field="@nameof(RagInstructionDto.IsActive)"
                                Title="وضعیت"
                                Width="100px" />

                    <GridColumn Field="@nameof(RagInstructionDto.CreateDateTime)"
                                Title="تاریخ ثبت"
                                Width="180px" />

                    <GridColumn Field="@nameof(RagInstructionDto.LastUpdateDateTime)"
                                Title="آخرین به‌روزرسانی"
                                Width="180px" />

                    <GridColumn Title="عملیات"
                                Width="230px" />

                </GridColumns>

            </TelerikGrid>
        }

    </ModalBodyContentHtml>

</Modal>
<div class="card-ai mb-4">
    <div class="card-ai-header">
        <span><i class="bi bi-card-checklist me-2"></i>@(EditingId is null ? "افزودن دستورالعمل جدید" : "ویرایش دستورالعمل")</span>
        @if (EditingId is not null)
        {
            <button class="btn btn-sm btn-outline-secondary" @onclick="ResetForm">
                <i class="bi bi-x me-1"></i>انصراف از ویرایش
            </button>
        }
    </div>
    <div class="p-4">
        <div class="row g-3 align-items-end">

            <div class="col-md-3">
                <label class="form-label fw-semibold">نوع سند</label>

                <TelerikDropDownList Data="@DocTypes"
                                     @bind-Value="Request.DocType"
                                     TextField="Title"
                                     ValueField="Code"
                                     Enabled="@(EditingId is null)"
                                     Class="w-100" />
            </div>

            <div class="col-md-3">
                <label class="form-label fw-semibold">
                    کلید (اختیاری)
                </label>

                <TelerikTextBox @bind-Value="Request.Key"
                                Placeholder="مثلاً: hr-policy-2025"
                                Class="w-100" />
            </div>

            <div class="col-md-3">
                <label class="form-label fw-semibold">
                    دسته‌بندی
                </label>

                <TelerikTextBox @bind-Value="Request.Category"
                                Placeholder="مثلاً: قوانین احراز هویت"
                                Class="w-100" />
            </div>

            <div class="col-md-3">
                <label class="form-label fw-semibold">
                    برچسب‌ها (اختیاری)
                </label>

                <TelerikTextBox @bind-Value="Request.Tags"
                                Placeholder="مثلاً: auth,security"
                                Class="w-100" />
            </div>

            <div class="col-md-12">
                <label class="form-label fw-semibold">
                    بارگذاری فایل متنی (اختیاری)
                </label>

                <InputFile OnChange="OnFileSelected"
                           class="form-control"
                           accept=".txt,.md,.markdown" />
            </div>

            <div class="col-md-12">
                <label class="form-label fw-semibold">
                    محتوای دستورالعمل
                </label>

                <TelerikEditor @bind-Value="Request.Content"
                               Height="300px" />
            </div>

            <div class="col-md-12">
                <div class="form-check">
                    <input type="checkbox"
                           class="form-check-input"
                           id="isSystematicCheck"
                           @bind="Request.IsSystematic" />

                    <label class="form-check-label fw-semibold"
                           for="isSystematicCheck">
                        سیستماتیک
                    </label>
                </div>
            </div>

            @if (EditingId is not null)
            {
                <div class="col-md-12">
                    <div class="form-check">
                        <input type="checkbox"
                               class="form-check-input"
                               id="isActiveCheck"
                               @bind="Request.IsActive" />

                        <label class="form-check-label fw-semibold"
                               for="isActiveCheck">
                            فعال
                        </label>
                    </div>
                </div>
            }

        </div>
        <div class="mt-3 d-flex gap-2 align-items-center">

            <button type="button"
                    class="btn btn-primary"
                    @onclick="SaveAsync"
                    disabled="@(IsSaving || string.IsNullOrWhiteSpace(Request.Content))">

                @if (IsSaving)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                }
                else
                {
                    <i class="bi bi-check2 me-1"></i>
                }

                @(EditingId is null ? "ذخیره" : "به‌روزرسانی")

            </button>

            <button type="button"
                    class="btn btn-light"
                    @onclick="OpenInstructionsModal"
                    disabled="@IsSaving">

                <i class="bi bi-card-checklist me-1"></i>
                نمایش دستورالعمل‌ها

            </button>

        </div>
    </div>
</div>

