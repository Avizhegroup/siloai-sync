@page "/rag-instructions"
@attribute [Authorize]
@using Microsoft.AspNetCore.Components.Forms
@using Telerik.Blazor.Components
@using SiloAI.Shared.Tools
@using SiloAI.UI.Components

<PageTitle>دستورالعمل‌ها — پنل مدیریت هوش مصنوعی سیلو</PageTitle>

<Modal Buttons="ModalButtons.Close"
       ModalTitle="دستورالعمل‌ها"
       CloseBtnText="بستن"
       @ref="ModalInstructions"
       Size="ModalSize.ExtraLarge">
    <ModalBodyContentHtml>
        @if (Instructions is { Count: 0 })
        {
            <div class="p-5 text-center text-muted">
                <i class="bi bi-card-checklist fs-2 d-block mb-2"></i>
                هیچ دستورالعملی ثبت نشده است.
            </div>
        }
        else if (Instructions is not null)
        {
            <TelerikGrid Data="@Instructions"
                         PageSize="10"
                         Pageable="true"
                         Sortable="true"
                         Resizable="true"
                         Navigable="true">
                <RowTemplate Context="instruction">
                    <td> <span class="badge-neutral">@instruction.DocType.ToDisplay()</span> </td>
                    <td> <span class="mono text-muted" dir="ltr">@(instruction.Key ?? "—")</span> </td>
                    <td> @(instruction.Category ?? "—") </td>
                    <td> <span class="mono text-muted" dir="ltr">@(instruction.Tags ?? "—")</span> </td>
                    <td>
                        @if (instruction.IsActive)
                        {
                            <span class="badge-active">فعال</span>
                        }
                        else
                        {
                            <span class="badge-neutral">غیرفعال</span>
                        }
                    </td>
                    <td>
                        <span class="mono text-muted"> @DateTimeTools.GetUnixPersianTime(instruction.CreateDateTime).ToNormalPersianDateTime()</span>
                    </td>
                    <td>
                        <span class="mono text-muted">
                            @(
                                instruction.LastUpdateDateTime.HasValue ? DateTimeTools.GetUnixPersianTime(instruction.LastUpdateDateTime.Value).ToNormalPersianDateTime(): "—"
                             )
                        </span>
                    </td>
                    <td class="text-end">
                        <button type="button"
                                class="btn btn-sm btn-outline-secondary me-1"
                                @onclick="() => StartEdit(instruction)"
                                disabled="@IsSaving">
                            <i class="bi bi-pencil me-1"></i>
                            ویرایش
                        </button>
                        <button type="button"
                                class="btn btn-sm btn-outline-danger"
                                @onclick="() => DeleteAsync(instruction.Id)"
                                disabled="@IsSaving">
                            <i class="bi bi-trash me-1"></i>
                            حذف
                        </button>
                    </td>
                </RowTemplate>
                <GridColumns>
                    <GridColumn Field="@nameof(RagInstructionDto.DocType)" Title="نوع" Width="130px" />
                    <GridColumn Field="@nameof(RagInstructionDto.Key)" Title="کلید" Width="160px" />
                    <GridColumn Field="@nameof(RagInstructionDto.Category)" Title="دسته‌بندی" Width="180px" />
                    <GridColumn Field="@nameof(RagInstructionDto.Tags)" Title="برچسب‌ها" Width="180px" />
                    <GridColumn Field="@nameof(RagInstructionDto.IsActive)" Title="وضعیت" Width="100px" />
                    <GridColumn Field="@nameof(RagInstructionDto.CreateDateTime)" Title="تاریخ ثبت" Width="180px" />
                    <GridColumn Field="@nameof(RagInstructionDto.LastUpdateDateTime)" Title="آخرین به‌روزرسانی" Width="180px" />
                    <GridColumn Title="عملیات" Width="230px" />
                </GridColumns>
            </TelerikGrid>
        }
    </ModalBodyContentHtml>
</Modal>

<div class="card-ai mb-4">
    <div class="card-ai-header">
        <span>
            <i class="bi bi-card-checklist me-2"></i>
            @(EditingId is null ? "افزودن دستورالعمل جدید" : "ویرایش دستورالعمل")
        </span>

        @if (EditingId is not null)
        {
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ResetForm">
                <i class="bi bi-x-lg me-1"></i>
                انصراف
            </button>
        }
    </div>
    <div class="p-3">
        <div class="row g-2">
            <div class="col-md-3">
                <label class="form-label">نوع سند</label>
                <TelerikDropDownList Data="@DocTypes"
                                     @bind-Value="Request.DocType"
                                     TextField="Title"
                                     ValueField="Code"
                                     Enabled="@(EditingId is null)"
                                     Width="100%" />
            </div>
            <div class="col-md-3">
                <label class="form-label">
                    کلید <span class="text-muted fw-normal">(اختیاری)</span>
                </label>
                <TelerikTextBox @bind-Value="Request.Key"
                                Placeholder="مثلاً: hr-policy-2025"
                                Width="100%" />
            </div>
            <div class="col-md-3">
                <label class="form-label">دسته‌بندی</label>
                <TelerikTextBox @bind-Value="Request.Category"
                                Placeholder="مثلاً: قوانین احراز هویت"
                                Width="100%" />
            </div>
            <div class="col-md-3">
                <label class="form-label">
                    برچسب‌ها <span class="text-muted fw-normal">(اختیاری)</span>
                </label>
                <TelerikTextBox @bind-Value="Request.Tags"
                                Placeholder="مثلاً: auth,security"
                                Width="100%" />
            </div>
            <div class="col-12">
                <label class="form-label">
                    بارگذاری فایل متنی <span class="text-muted fw-normal">(اختیاری)</span>
                </label>
                <div class="file-drop d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-file-earmark-text text-primary"></i>
                        <span class="small">فایل متنی را انتخاب کنید</span>
                    </div>
                    <label class="btn btn-outline-primary btn-sm mb-0">
                        <i class="bi bi-folder2-open me-1"></i>
                        انتخاب فایل
                        <InputFile OnChange="OnFileSelected"
                                   class="d-none"
                                   accept=".txt,.md,.markdown" />
                    </label>
                </div>
            </div>
            <div class="col-12">
                <label class="form-label">محتوای دستورالعمل</label>
                <textarea class="form-control rag-content-editor"
                          rows="14"
                          @bind="Request.Content"
                          spellcheck="false"></textarea>
            </div>
            <div class="col-12 mt-1">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div class="d-flex flex-wrap gap-4">
                        <div class="form-check mb-0">
                            <input type="checkbox"
                                   class="form-check-input"
                                   id="isSystematicCheck"
                                   @bind="Request.IsSystematic" />
                            <label class="form-check-label fw-medium"
                                   for="isSystematicCheck">
                                سیستماتیک
                            </label>
                        </div>
                        @if (EditingId is not null)
                        {
                            <div class="form-check mb-0">
                                <input type="checkbox"
                                       class="form-check-input"
                                       id="isActiveCheck"
                                       @bind="Request.IsActive" />
                                <label class="form-check-label fw-medium"
                                       for="isActiveCheck">
                                    فعال
                                </label>
                            </div>
                        }
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button"
                                class="btn btn-primary px-4"
                                @onclick="SaveAsync"
                                disabled="@(IsSaving || string.IsNullOrWhiteSpace(Request.Content))">
                            <i class="bi bi-check2 me-1"></i>
                            <span>@(EditingId is null ? "ذخیره" : "به‌روزرسانی")</span>
                        </button>

                        <button type="button"
                                class="btn btn-outline-secondary"
                                @onclick="OpenInstructionsModal"
                                disabled="@IsSaving">
                            <i class="bi bi-card-checklist me-1"></i>
                            نمایش دستورالعمل‌ها
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (IsSaving || IsLoading)
{
    <TelerikLoaderContainer LoaderPosition="@LoaderPosition.End"
                            LoaderType="LoaderType.InfiniteSpinner"
                            Text="در حال ذخیره...">
    </TelerikLoaderContainer>
}
