@page "/rag-instructions"
@attribute [Authorize]
@using Microsoft.AspNetCore.Components.Forms
@using Telerik.Blazor.Components

<PageTitle>دستورالعمل‌ها — پنل مدیریت هوش مصنوعی سیلو</PageTitle>


<div class="card-ai">
    <div class="card-ai-header">
        <span><i class="bi bi-list-check me-2"></i>دستورالعمل‌ها</span>
        <span class="text-muted small">@(_instructions?.Count ?? 0) مورد</span>
    </div>
    @if (_isLoading && _instructions is null)
    {
        <div class="p-4 text-center text-muted">
            <div class="spinner-border spinner-border-sm me-2"></div>در حال بارگذاری...
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>نوع</th>
                        <th>کلید</th>
                        <th>دسته‌بندی</th>
                        <th>برچسب‌ها</th>
                        <th>وضعیت</th>
                        <th>تاریخ ثبت</th>
                        <th>آخرین به‌روزرسانی</th>
                        <th class="text-end">عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_instructions is { Count: 0 })
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">
                                <i class="bi bi-card-checklist me-2"></i>هیچ دستورالعملی ثبت نشده است.
                            </td>
                        </tr>
                    }
                    @foreach (var instruction in _instructions ?? [])
                    {
                        <tr>
                            <td><span class="badge bg-secondary">@instruction.DocType.ToDisplay()</span></td>
                            <td class="text-muted">@(instruction.Key ?? "—")</td>
                            <td>@(instruction.Category ?? "—")</td>
                            <td class="text-muted">@(instruction.Tags ?? "—")</td>
                            <td>
                                @if (instruction.IsActive)
                                {
                                    <span class="badge bg-success">فعال</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">غیرفعال</span>
                                }
                            </td>
                            <td class="text-muted">@instruction.CreateDateTime.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td>
                            <td class="text-muted">@(instruction.LastUpdateDateTime?.ToLocalTime().ToString("yyyy/MM/dd HH:mm") ?? "—")</td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-secondary me-1"
                                        @onclick="() => StartEdit(instruction)" disabled="@_isSaving">
                                    <i class="bi bi-pencil me-1"></i>ویرایش
                                </button>
                                <button class="btn btn-sm btn-outline-danger"
                                        @onclick="() => DeleteAsync(instruction.Id)" disabled="@_isSaving">
                                    <i class="bi bi-trash me-1"></i>حذف
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
<div class="card-ai mb-4">
    <div class="card-ai-header">
        <span><i class="bi bi-card-checklist me-2"></i>@(_editingId is null ? "افزودن دستورالعمل جدید" : "ویرایش دستورالعمل")</span>
        @if (_editingId is not null)
        {
            <button class="btn btn-sm btn-outline-secondary" @onclick="ResetForm">
                <i class="bi bi-x me-1"></i>انصراف از ویرایش
            </button>
        }
    </div>
    <div class="p-4">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label fw-semibold">نوع سند</label>
                <select class="form-select" @bind="_docType">
                    @foreach (var type in Enum.GetValues<RagDocType>())
                    {
                        <option value="@type">@type.ToDisplay()</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold">کلید (اختیاری)</label>
                <input type="text" class="form-control" placeholder="مثلاً: hr-policy-2025" @bind="_key" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold">دسته‌بندی</label>
                <input type="text" class="form-control" placeholder="مثلاً: قوانین احراز هویت" @bind="_category" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold">برچسب‌ها (اختیاری)</label>
                <input type="text" class="form-control" placeholder="مثلاً: auth,security" @bind="_tags" />
            </div>
            <div class="col-md-12">
                <label class="form-label fw-semibold">بارگذاری فایل متنی (اختیاری)</label>
                <InputFile OnChange="OnFileSelected" class="form-control" accept=".txt,.md,.markdown" />
            </div>
            <div class="col-md-12">
                <label class="form-label fw-semibold">محتوای دستورالعمل</label>
                <TelerikEditor @bind-Value="_content" Height="300px"></TelerikEditor>
            </div>
            @if (_editingId is not null)
            {
                <div class="col-md-12">
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="isActiveCheck" @bind="_isActive" />
                        <label class="form-check-label fw-semibold" for="isActiveCheck">فعال</label>
                    </div>
                </div>
            }
        </div>
        <div class="mt-3 d-flex gap-2 align-items-center">
            <button class="btn btn-primary" @onclick="SaveAsync" disabled="@(_isSaving || string.IsNullOrWhiteSpace(_content))">
                @if (_isSaving)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                }
                else
                {
                    <i class="bi bi-check2 me-1"></i>
                }
                @(_editingId is null ? "ذخیره" : "به‌روزرسانی")
            </button>
        </div>
    </div>
</div>

