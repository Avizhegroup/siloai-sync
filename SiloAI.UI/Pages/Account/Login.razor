@page "/account/login"
@attribute [AllowAnonymous]

<PageTitle>ورود — پنل مدیریت هوش مصنوعی سیلو</PageTitle>

<div class="login-bg">
    <div class="login-card">
        <div class="login-logo">
            <div class="logo-icon" aria-hidden="true"><i class="bi bi-robot"></i></div>
            <h2>پنل مدیریت هوش مصنوعی سیلو</h2>
            <p>برای ادامه، وارد حساب کاربری خود شوید.</p>
        </div>

        <EditForm Model="Request" OnValidSubmit="OnLoginSubmit" class="login-form">
            <DataAnnotationsValidator />

            <div class="field-group">
                <label class="field-label" for="login-username">نام کاربری</label>
                <div class="field">
                    <i class="bi bi-person field-icon" aria-hidden="true"></i>
                    <InputText id="login-username"
                               @bind-Value="Request.Username"
                               class="field-input"
                               autocomplete="username"
                               placeholder="نام کاربری خود را وارد کنید" />
                </div>
                <ValidationMessage For="() => Request.Username" class="field-error" />
            </div>

            <div class="field-group">
                <label class="field-label" for="login-password">رمز عبور</label>
                <div class="field">
                    <i class="bi bi-lock field-icon" aria-hidden="true"></i>
                    <InputText id="login-password"
                               @bind-Value="Request.Password"
                               type="@(_showPassword ? "text" : "password")"
                               class="field-input"
                               autocomplete="current-password"
                               placeholder="رمز عبور خود را وارد کنید" />
                    <button type="button"
                            class="field-toggle"
                            aria-label="@(_showPassword ? "پنهان کردن رمز عبور" : "نمایش رمز عبور")"
                            @onclick="() => _showPassword = !_showPassword">
                        <i class="bi @(_showPassword ? "bi-eye-slash" : "bi-eye")"></i>
                    </button>
                </div>
                <ValidationMessage For="() => Request.Password" class="field-error" />
            </div>

            <button type="submit" class="btn-ai-primary" disabled="@IsLoading">
                @if (IsLoading)
                {
                    <span class="spinner-border spinner-border-sm" role="status"></span>
                    <span>در حال ورود...</span>
                }
                else
                {
                    <i class="bi bi-box-arrow-in-right"></i>
                    <span>ورود</span>
                }
            </button>
        </EditForm>
    </div>
</div>

